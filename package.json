{
  "name": "bravado-core",
  "version": "0.19.0",
  "description": "REST (Level 3/HATEOAS) API Framework",
  "directories": {
    "lib": "lib"
  },
  "type": "module",
  "scripts": {
    "reinstall": "rm -rf node_modules && pnpm install",
    "lint": "eslint . --ext .js",
    "lint:fix": "pnpm lint --fix",
    "lint:changed": "lint-staged",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.10.0",
  "main": "lib/index.js",
  "author": "Losant <hello@losant.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Losant/bravado-core/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Losant/bravado-core.git"
  },
  "keywords": [
    "rest",
    "restful",
    "server",
    "api"
  ],
  "lint-staged": {
    "*.js": "eslint"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "convict": "^6.2.5",
    "error": "^7.2.1",
    "fast-jwt": "^6.2.4",
    "fs-extra": "^11.3.6",
    "js-yaml": "^4.3.0",
    "json-refs": "^3.0.15",
    "lodash": "^4.18.1",
    "node-dir": "^0.1.17",
    "traverse": "^0.6.11",
    "uri-template": "^2.0.0"
  },
  "devDependencies": {
    "@losant/eslint-config-losant": "^2.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8"
